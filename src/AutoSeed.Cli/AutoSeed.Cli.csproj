<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>autoseed</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EFCore.AutoSeed.Cli</PackageId>
    <Description>Command-line tool for EFCore.AutoSeed: prints the seeding plan for a DbContext without writing anything.</Description>
    <PackageTags>ef-core;entity-framework;testing;test-data;seeding;bogus;fixtures</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>EFCore.AutoSeed.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSeed.Inference\AutoSeed.Inference.csproj" />
    <ProjectReference Include="..\AutoSeed.Distributions\AutoSeed.Distributions.csproj" />
    <ProjectReference Include="..\AutoSeed.Coverage\AutoSeed.Coverage.csproj" />
    <ProjectReference Include="..\AutoSeed.Shape\AutoSeed.Shape.csproj" />
    <ProjectReference Include="..\AutoSeed.Providers\AutoSeed.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="/" />
    <None Include="..\..\demo.gif" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoSeed.UnitTests" />
  </ItemGroup>

</Project>
