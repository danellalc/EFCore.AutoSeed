<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EFCore.AutoSeed</PackageId>
    <Description>Seeds a database by reading the EF Core model. No factories, no CSV, no manual ordering.</Description>
    <PackageTags>ef-core;entity-framework;testing;test-data;seeding;bogus;fixtures</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>EFCore.AutoSeed.Inference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSeed.Core\AutoSeed.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AutoSeed.Coverage\AutoSeed.Coverage.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AutoSeed.Distributions\AutoSeed.Distributions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AutoSeed.Providers\AutoSeed.Providers.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AutoSeed.Shape\AutoSeed.Shape.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AutoSeed.Analyzers\AutoSeed.Analyzers.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="/" />
    <None Include="..\..\demo.gif" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    AutoSeed.Core, AutoSeed.Coverage, AutoSeed.Distributions and AutoSeed.Providers are internal
    implementation projects, never published on their own. Without this, dotnet pack lists each as
    an unresolvable NuGet dependency instead of bundling its DLL here. Their own PackageReferences
    (Microsoft.EntityFrameworkCore.Relational, Microsoft.EntityFrameworkCore.SqlServer,
    Microsoft.Data.SqlClient, Npgsql) are declared again, directly, above: a project reference
    marked PrivateAssets="all" also hides the referenced
    project's own package dependencies from the consumer, so they must be restated here or a
    consumer installing EFCore.AutoSeed would silently be missing them at runtime.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('Extension', '.dll'))" />
    </ItemGroup>
  </Target>

  <!--
    A Roslyn analyzer ships in its own analyzers/dotnet/cs folder inside the package, never in
    lib/, so a consumer's compiler loads it without also referencing it as a normal library (it
    targets netstandard2.0 unconditionally, unrelated to the consumer's own TargetFramework). The
    ProjectReference above builds AutoSeed.Analyzers as part of this package's own build, with
    ReferenceOutputAssembly="false" so it is never added as an ordinary compile-time reference.
  -->
  <Target Name="AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\AutoSeed.Analyzers\bin\$(Configuration)\netstandard2.0\AutoSeed.Analyzers.dll"
            Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
